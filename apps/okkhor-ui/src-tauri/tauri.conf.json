{
  "productName": "Okkhor",
  "version": "0.9.13",
  "identifier": "app.okkhor.ui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Okkhor Settings",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      },
      {
        "label": "quickbar",
        "title": "Okkhor Quick Bar",
        "width": 340,
        "height": 52,
        "minWidth": 300,
        "maxWidth": 560,
        "minHeight": 44,
        "maxHeight": 52,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "quickadd",
        "title": "Add word",
        "width": 340,
        "height": 132,
        "minWidth": 300,
        "maxWidth": 560,
        "minHeight": 60,
        "maxHeight": 132,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/okkhor.ico"]
  }
}
