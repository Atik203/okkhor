# Okkhor local development environment.
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
#
# These variables are for local development and QA. The 0.7 AI worker reads
# them from the process environment; a packaged build should use the user's
# environment instead of a file next to the executable.
#
# OpenAI API key. Do not paste a key into a tracked file or a chat.
OKKHOR_OPENAI_API_KEY=
#
# Model id used by the rewrite action. Leave unset to use the worker's
# documented default. Set it to a model available in your OpenAI account.
OKKHOR_AI_MODEL=
